{
  "schema_version": 1,
  "name": "xhs",
  "display_name": "小红书",
  "default_enabled": false,
  "fields": {
    "use_proxy": {
      "type": "bool",
      "label": "使用代理",
      "default": false
    },
    "cookie": {
      "type": "text",
      "label": "Cookie",
      "hint": "可选；若要解析需登录的图文或视频请填写网页 Cookie",
      "secret": true,
      "default": ""
    },
    "video_quality": {
      "type": "select",
      "label": "视频清晰度偏好",
      "options": [
        "auto",
        "4k",
        "2k",
        "1080p",
        "720p",
        "540p"
      ],
      "default": "auto"
    }
  }
}