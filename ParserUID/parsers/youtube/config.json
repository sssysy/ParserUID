{
  "schema_version": 1,
  "name": "youtube",
  "display_name": "YouTube",
  "default_enabled": false,
  "fields": {
    "use_proxy": {
      "type": "bool",
      "label": "使用代理",
      "hint": "YouTube 通常需要代理；代理地址沿用插件全局配置",
      "default": false
    },
    "cookie": {
      "type": "text",
      "label": "Cookie",
      "hint": "选填，用于访问限制内容",
      "secret": true,
      "default": ""
    },
    "media_mode": {
      "type": "select",
      "label": "媒体模式",
      "options": ["auto", "video", "audio"],
      "default": "auto"
    },
    "video_quality": {
      "type": "select",
      "label": "视频画质上限",
      "options": ["auto", "2160p", "1440p", "1080p", "720p", "480p", "360p"],
      "default": "720p"
    },
    "video_codec": {
      "type": "select",
      "label": "视频编码偏好",
      "options": ["auto", "avc", "hevc", "av1"],
      "default": "auto"
    },
    "clip_seconds": {
      "type": "int",
      "label": "超长视频截取时长",
      "hint": "单位秒，0 表示不截取；视频超过该时长时只下载开头片段",
      "default": 0
    },
    "include_channel_info": {
      "type": "bool",
      "label": "补全频道资料",
      "default": true
    }
  }
}
