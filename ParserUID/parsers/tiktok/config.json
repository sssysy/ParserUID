{
  "schema_version": 1,
  "name": "tiktok",
  "display_name": "TikTok",
  "default_enabled": false,
  "fields": {
    "use_proxy": {
      "type": "bool",
      "label": "使用代理",
      "default": false
    },
    "cookie": {
      "type": "text",
      "label": "Cookie",
      "hint": "选填，Cookie 字符串",
      "secret": true,
      "default": ""
    },
    "video_quality": {
      "type": "select",
      "label": "视频画质偏好",
      "options": ["auto", "1080p", "720p", "540p"],
      "default": "auto"
    }
  }
}
